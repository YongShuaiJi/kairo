# Kairo V1.7 release Compose environment template (roadmap §12.2).
#
# Copy to `.env` and replace every REQUIRED value with a real secret generated by your
# organization. This template ships NO default/development token or secret. The Compose file
# uses ${VAR:?...} for every secret so deployment fails fast if a value is forgotten.

# --- PostgreSQL 16 ---
KAIRO_DB_NAME=kairo
KAIRO_DB_USER=kairo
# REQUIRED: a strong PostgreSQL password.
KAIRO_DB_PASSWORD=__SET_A_STRONG_POSTGRES_PASSWORD__

# --- Platform (kairo-platform-server) ---
# REQUIRED: bootstrap admin token used to initialize the Platform's local-token auth mode.
KAIRO_BOOTSTRAP_TOKEN=__SET_THE_PLATFORM_BOOTSTRAP_ADMIN_TOKEN__
# REQUIRED: token the attach CLI / agents use to register and poll against the Platform.
KAIRO_ATTACH_PLATFORM_TOKEN=__SET_THE_ATTACH_PLATFORM_TOKEN__

# --- Web (kairo-platform-web) ---
# REQUIRED: signing key for web session cookies.
KAIRO_WEB_SESSION_KEY=__SET_A_STRONG_WEB_SESSION_KEY__
