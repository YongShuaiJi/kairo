<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.kairo</groupId>
    <artifactId>kairo-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Kairo Parent</name>
    <description>Java runtime method mocking and fault injection system.</description>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0 only</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>kairo-bootstrap-api</module>
        <module>kairo-api</module>
        <module>kairo-groovy</module>
        <module>kairo-core</module>
        <module>kairo-agent-core</module>
        <module>kairo-agent-server</module>
        <module>kairo-agent-core-modern</module>
        <module>kairo-agent-bootstrap</module>
        <module>kairo-attach-cli</module>
        <module>kairo-ops</module>
        <module>kairo-platform-server</module>
        <module>kairo-sdk</module>
        <module>kairo-cli</module>
        <module>kairo-mcp</module>
        <module>kairo-demo</module>
        <module>kairo-integration-tests</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- V1.7 M5-A §12.1: one CI-friendly reactor version family. The developer default is
             1.7.0-SNAPSHOT; release/RC builds override with -Drevision=1.7.0-rc.N or -Drevision=1.7.0
             without editing any child POM. Child modules inherit ${revision} and internal
             dependencies use ${project.version}, so the whole reactor resolves to a single value. -->
        <revision>1.7.0-SNAPSHOT</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <byte-buddy.version>1.17.8</byte-buddy.version>
        <groovy.version>4.0.24</groovy.version>
        <!-- V1.7 M5-C security bugfix: pinned to 2.18.8, the Grype 0.116.1 observed minimum fixed
             line for jackson-core/jackson-databind. Spring Boot 3.5.16 manages Jackson 2.21.4, but the
             published jackson-databind 2.21.4 POM references jackson-annotations via the decoupled
             ${jackson.version.annotations} property (2.20+ dropped the patch from annotations); under BOM
             import that resolves to the non-existent 2.21.4 and breaks the build. 2.18.8 is pre-2.20, so
             jackson.version.annotations == jackson.version == 2.18.8 and the whole family (core, databind,
             annotations, datatypes, dataformats, modules) resolves coherently. The jackson-bom 2.18.8
             import in dependencyManagement (declared before the Spring Boot BOM) makes this override win. -->
        <jackson.version>2.18.8</jackson.version>
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <spring-boot.version>3.5.16</spring-boot.version>
        <vineflower.version>1.12.0</vineflower.version>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
        <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
        <!-- V1.7 M5-C security bugfix (bugfix/v1.7-security-dependencies): the fail-closed Grype 0.116.1
             gate blocked Spring Boot 3.3.7 / Spring Framework 6.1.16 (advisories with no fix on the 3.3/6.1
             line), Jackson 2.17.x, Netty 4.1.116.Final, PostgreSQL 42.7.4 and Tomcat 10.1.34. Moving to the
             maintained Spring Boot 3.5.16 line (Spring Framework 6.2.19) clears the Spring advisories and
             raises Tomcat to 10.1.55 (>= the 10.1.55 minimum). Spring Boot 3.5.16 still manages Netty at
             4.1.135.Final and PostgreSQL at 42.7.11, just below the gate minimums (netty-codec >=
             4.1.136.Final; postgresql >= 42.7.12). Because this reactor imports spring-boot-dependencies as
             a BOM (rather than extending spring-boot-starter-parent), BOM-internal property overrides are
             resolved with the BOM's own values; the two versions below are therefore applied as explicit
             dependencyManagement entries (a netty-bom import declared before the Spring Boot BOM, plus a
             direct postgresql entry) that take precedence over the imported BOM and keep each family
             coherent at a single version rather than scattering direct dependencies across modules. -->
        <netty.version>4.1.136.Final</netty.version>
        <postgresql.version>42.7.12</postgresql.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- V1.7 M5-C security bugfix: declared before the Spring Boot BOM so this jackson-bom import
                 wins on first-declaration precedence over Spring Boot 3.5.16's managed 2.21.4, pinning the
                 whole Jackson family (core, databind, annotations, datatypes, dataformats, modules) to the
                 coherent 2.18.8 line (>= the 2.18.8 gate minimum; avoids the 2.20+ annotations POM defect). -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- V1.7 M5-C security bugfix: declared before the Spring Boot BOM so this netty-bom import
                 wins on first-declaration precedence over Spring Boot 3.5.16's managed 4.1.135.Final,
                 raising every Netty module to 4.1.136.Final (>= the gate minimum for netty-codec and
                 netty-handler) as one coherent family. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- V1.7 M5-C security bugfix: direct dependencyManagement entry takes precedence over the
                 Spring Boot 3.5.16 BOM's managed 42.7.11, pinning the JDBC driver to 42.7.12 (>= gate). -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy</artifactId>
                <version>${groovy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vineflower</groupId>
                <artifactId>vineflower</artifactId>
                <version>${vineflower.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
